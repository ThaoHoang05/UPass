{
    "manifest_version": 3,
    "name": "UPass",
    "version": "1.0.0",
    "description": "UPass is a password manager that helps you securely store and manage your passwords.",
    "permission": ["activeTab", "scripting", "storage"],
    "action":{
        "default_popup": "popup.html"
    },
    "content_scripts":{
        "js": ["/scripts/content.js"],
        "matches": ["<all_urls>"]
    }
}