{
    "manifest_version": 3,
    "name": "UPass",
    "version": "1.0.0",
    "description": "UPass is a password manager that helps you securely store and manage your passwords.",
    "permissions": ["activeTab", "scripting", "storage"],
    "action": {
        "default_popup": "scripts/popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["scripts/content.js"]
        }
    ]
}