{
    "manifest_version": 3,
    "name": "UPass",
    "version": "1.0.0",
    "description": "UPass is a password manager that helps you securely store and manage your passwords.",
    "permissions": ["activeTab", "scripting", "storage"],
    "action": {
        "default_popup": "scripts/popup.html"
    },
    "background": {
        "service_worker": "scripts/background.js"
    },
    "host_permissions": ["<all_urls>"],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["scripts/credentialScan.js", "scripts/content.js"],
        "run_at": "document_idle",
        "all_frames": true
      }
    ],
    "options_page": "scripts/option.html"
}